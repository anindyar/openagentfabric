      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oaf-prometheus"
          },
          "expr": "sum(rate(agentgateway_requests_total[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Requests/s",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "oaf-prometheus"
      },
      "fieldConfig": {
