          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "oaf-prometheus"
          },
          "expr": "(sum(rate(agentgateway_requests_total{status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(agentgateway_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Errors (5xx) %",
