        },
        "datasource": {
          "type": "prometheus",
          "uid": "oaf-prometheus"
        },
        "definition": "label_values(vllm:num_requests_running, model)",
        "includeAll": true,
        "label": "Model",
        "multi": true,
        "name": "model",
        "query": {
          "query": "label_values(vllm:num_requests_running, model)",
          "refId": "vars"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
